# Bu dosyayı .streamlit/secrets.toml olarak kopyalayıp doldurun (o dosya
# .gitignore'da, asla git'e girmez). Streamlit Community Cloud'da bunun yerine
# uygulama ayarlarındaki "Secrets" panelini kullanın (içerik birebir aynı
# TOML formatında yapıştırılır).
#
# AUTH_SALT / AUTH_PASSWORD_HASH üretmek için (şifreyi düz metin saklamamak
# için) auth.hash_password(password, salt) fonksiyonunu kullanın; salt için
# secrets.token_hex(16).

AUTH_USERNAME = "kullanici_adiniz"
AUTH_SALT = "buraya_uretilen_salt"
AUTH_PASSWORD_HASH = "buraya_uretilen_hash"

API_FOOTBALL_KEY = "buraya_api_sports_io_dan_aldigin_key_i_yapistir"
TELEGRAM_BOT_TOKEN = "buraya_botfather_dan_aldigin_token_u_yapistir"
TELEGRAM_CHAT_ID = "buraya_kanal_id_sini_yapistir"
NOSYAPI_API_KEY = "buraya_nosyapi_com_dan_aldigin_key_i_yapistir"
